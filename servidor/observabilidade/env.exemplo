# Copie para `.env` ao lado do docker-compose.yml e troque o que importa:
#
#     cp env.exemplo .env
#
# O `.env` NÃO é versionado — o `.gitignore` o barra na raiz do repositório.

# 🔴 Obrigatória: sem ela o compose se recusa a subir. Gere uma de verdade —
#
#     python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
#
# Este painel mostra onde o carro esteve e quando. Não é lugar de admin/admin.
GRAFANA_SENHA=

# Opcionais.
GRAFANA_USUARIO=admin
CORUJA_PORTA_GRAFANA=3000
