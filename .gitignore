__pycache__/
*.pyc
*.bak
_fzz_tmp/
.DS_Store

# firmware
firmware/build*/
coruja.cfg

# .fzz de comparação, gerados por gera_fritzing.py --saida
coruja_gps_v*.fzz

# base servida pela API — derivada, nao versionada
servidor/dados/*
!servidor/dados/.gitkeep

# o que os aparelhos mandam: log, viagens e infracoes. Sao dados de uso do
# aparelho -- onde ele esteve e quando. Nunca versionar.
servidor/recebidos/*
!servidor/recebidos/.gitkeep

# a lista de aparelhos tem os SEGREDOS de verdade. O .exemplo e versionado.
servidor/aparelhos.cfg

# Atalho para a pty do simulador, recriado a cada execucao.
simulador/serial
.venv/

# KiCad: artefatos gerados e sujeira da ferramenta. O .kicad_sch e o
# .kicad_sym SAO versionados — saem do netlist.py e sao o projeto.
kicad/coruja_esquematico.pdf
kicad/*-backups/
kicad/fp-info-cache
kicad/*.kicad_prl
kicad/*.net
kicad/.history/
kicad/*.lck
kicad/~*

# Pacote de fabricacao: 100% derivado do .kicad_pcb, que e versionado.
# Regerar com os comandos no pcb.md.
kicad/fabricacao/

# Lixo que o KiCad cria ao recuperar sessao.
kicad/_restore_backup_*/

# Pacote de fabricacao zipado: sai do .kicad_pcb, que e versionado.
kicad/*.zip
