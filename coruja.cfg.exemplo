# Configuração do Coruja GPS. Vai na raiz do cartão microSD.
# Gerado por scripts/gera_config.py.
#
# O cartão é removível e legível por qualquer um: use uma rede de
# convidados ou de IoT, nunca a principal da casa.
#
# Só entra aqui o que varia por instalação ou por gosto. Fuso,
# tolerâncias e calibração do LED ficam no código (docs/adr/0002).

# Redes em ordem de PRIORIDADE, até 5. Ao clicar no encoder o
# aparelho varre e conecta na primeira desta lista que estiver visível.
wifi_ssid_1=troque-me
wifi_senha_1=troque-me
wifi_ssid_2=troque-me
wifi_senha_2=troque-me

# --- diagnóstico ------------------------------------------------------
#
# log_to_sd: grava todas as mensagens de log em coruja.log, no cartão.
# Desligado por padrão porque escrita de cartão tem ciclos finitos —
# é recurso para ficar ligado enquanto se procura um defeito.
# Aceita true/false ou 1/0.
log_to_sd=false

# log_level: abaixo deste nível as mensagens são descartadas, no
# console e no cartão. debug, info, warning (ou warn), error.
#
# NO CARRO, 'info'. Em 'info' um evento é UMA linha, com o desfecho:
# a configuração do GPS inteira sai resumida, o Wi-Fi sai como "em qual
# rede tentei e o que deu". 'debug' devolve o passo a passo — cada ACK
# da configuração, cada rede do vizinho, cada certificado da cadeia,
# cada arquivo aberto no cartão — e triplica o arquivo que sobe pela
# rede. É nível de bancada.
log_level=info

# Devolve a versão disponível: uma linha de texto qualquer, comparada
# como texto com a que o aparelho guardou.
#
# Em https:// o aparelho VERIFICA o certificado contra tres raizes
# embutidas no firmware, e recusa quem nao se encaixa. Isso exige o
# relogio acertado -- ver servidor_ntp acima.
url_versao=https://exemplo/radares.versao
# Entrega o radares.bin. O RF05.2 exige HTTPS.
url_base=https://exemplo/radares.bin

# --- identificacao no servidor (opcional) -----------------------
#
# token_aparelho: o segredo que diz ao servidor QUAL unidade esta
# falando. Ele guarda uma lista de aparelhos, cada um com seu
# token (aparelhos.cfg), e usa isso para separar os registros de
# cada carro.
#
# Vai em TODAS as requisicoes, nao so nos envios. Se o servidor tem
# lista de aparelhos, ele recusa ate o download da base sem token.
# Se nao tem, as rotas da base ficam abertas e esta linha nao faz
# falta -- e por isso ela vem comentada.
#
# ATENCAO: viaja EM CLARO, e na rota de download vai dentro da URL
# (?t=...), porque o cliente HTTP do aparelho nao manda cabecalho
# proprio. Token em URL entra no log de acesso do servidor e de
# qualquer proxy no caminho. Ele nao protege o conteudo de quem
# escuta a rede -- existe para que a URL nao seja aberta a quem a
# descobrir.
#token_aparelho=troque-me-por-algo-longo-e-aleatorio

# De onde vem a hora. Vazio usa pool.ntp.br.
#
# Isto NAO e enfeite: o aparelho valida o certificado do servidor
# contra a data, e o RP2350 nao tem bateria no relogio -- todo boot
# comeca sem hora. Sem acertar, TODO certificado e recusado por
# 'ainda nao vale' e o OTA para.
#
# O NTP vem antes do GPS de proposito: atualizar so acontece com
# Wi-Fi, ou seja, com o carro parado onde ha rede -- garagem,
# estacionamento coberto. E exatamente onde o GPS nao pega.
#
# ATENCAO: NTP e UDP sem autenticacao. Quem controla a rede escolhe
# a hora que o aparelho acredita, e com ela pode fazer um
# certificado vencido parecer valido. Aponte para um servidor da
# propria rede se isso incomodar.
#servidor_ntp=pool.ntp.br

# --- envio de dados ao servidor (opcional) ----------------------
#
# O item 'enviar dados' do menu sobe coruja.log, infracoes.log e os
# registros de viagem, e apaga do cartao SO o que o servidor
# confirmar ter guardado, pelo CRC-32.
#
# DESLIGADO enquanto esta linha e o token_aparelho estiverem vazios
# ou comentados, e esse e o padrao: o aparelho nao manda nada para
# lugar nenhum enquanto alguem nao disser para onde.
#
# Precisa dos DOIS. So a URL significaria mandar para um servidor
# que aceita de qualquer um.
#url_envio=http://exemplo/envio/

# --- ajustes do aparelho ----------------------------------------
#
# Daqui para baixo o APARELHO tambem escreve, ao mexer no menu com o
# carro parado. A gravacao e cirurgica: ele troca so o valor destas
# chaves e preserva o resto do arquivo, comentarios inclusive. Pode
# editar a mao; vale o ultimo que escreveu.

# Identifica a unidade. Com mais de um aparelho os ajustes divergem,
# e trocar os cartoes sem perceber aplicaria os ajustes do outro
# carro em silencio. Aparece no boot e em cada linha do log.
nome=coruja

# Brilho da tela por periodo, de 0 a 100 em passos de 5.
#
# ZERO NAO APAGA A TELA: e o mais escuro que o painel consegue
# mostrar. O minimo real de luminancia e do hardware, medido na
# bancada (R-05), e nao aparece aqui -- ele ja mudou uma vez e
# pode mudar com outro painel, sem que este arquivo precise ser
# reescrito. Sao dois valores
# porque o ajuste manual vale por periodo: acerta-se uma vez de dia
# e uma de noite, e a troca seguinte ja vem certa.
brilho_dia=100
brilho_noite=20

# auto  = decide por nascer e por do sol, calculados pela posicao
# dia   = forca tela clara (garagem coberta ao meio-dia)
# noite = forca tela escura
modo_noturno=auto

# O LED RGB acende? true ou false.
#
# Existe por relato de uso de 19/10/2026: a noite o LED de 10 mm difuso
# ilumina a cabine inteira e incomoda mais do que informa. Desligado, nenhum
# uso dele acende -- nem o alerta, nem o padrao do OTA, nem o teste de
# alertas. A tela continua mostrando tudo, e o buzzer continua tocando.
#
# Tambem da para mexer no menu do encoder, parado.
led=true

# Intensidade do LED por periodo, em passos de 5, de 5 a 100.
#
# O PISO E 5, e nao zero: zero e o que o `led` acima faz, e dois ajustes
# capazes de apagar o LED disputariam o mesmo resultado.
#
# A escala e LINEAR, ao contrario da do brilho da tela. O motivo sao as cores
# calibradas: um matiz composto e uma RAZAO entre canais de 8 bits -- o ambar
# e {255, 50, 0} --, e uma curva perceptual levaria o canal secundario a
# valores de um digito, onde a quantizacao destroi a razao e o ambar vira
# vermelho alaranjado.
#
# 20 de noite e palpite de partida, a acertar na estrada.
led_dia=100
led_noite=20

# O `volume_buzzer` saiu em 19/10/2026 e esta linha nao existe mais. O SFM-27
# e um buzzer ATIVO, com oscilador proprio: aceita ligado ou desligado, e
# nunca houve volume a controlar. Se ela ainda estiver no seu cartao, pode
# apagar -- o aparelho a le e ignora.
