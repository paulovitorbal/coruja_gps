# Configuração do Coruja GPS. Vai na raiz do cartão microSD.
# Gerado por scripts/gera_config.py.
#
# O cartão é removível e legível por qualquer um: use uma rede de
# convidados ou de IoT, nunca a principal da casa.
#
# Só entra aqui o que varia por instalação. Brilho, fuso, tolerâncias
# e calibração do LED ficam no código (docs/adr/0002).

# Redes em ordem de PRIORIDADE, até 5. Ao clicar no encoder o
# aparelho varre e conecta na primeira desta lista que estiver visível.
wifi_ssid_1=troque-me
wifi_senha_1=troque-me
wifi_ssid_2=troque-me
wifi_senha_2=troque-me

# --- diagnóstico ------------------------------------------------------
#
# log_to_sd: grava todas as mensagens de log em coruja.log, no cartão.
# Desligado por padrão porque escrita de cartão tem ciclos finitos —
# é recurso para ficar ligado enquanto se procura um defeito.
# Aceita true/false ou 1/0.
log_to_sd=false

# log_level: abaixo deste nível as mensagens são descartadas, no
# console e no cartão. debug, info, warning (ou warn), error.
# 'debug' inclui a varredura de Wi-Fi inteira e cada partição sondada.
log_level=info

# Devolve a versão disponível: uma linha de texto qualquer, comparada
# como texto com a que o aparelho guardou.
url_versao=https://exemplo/radares.versao
# Entrega o radares.bin. O RF05.2 exige HTTPS.
url_base=https://exemplo/radares.bin
