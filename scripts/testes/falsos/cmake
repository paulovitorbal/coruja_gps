#!/bin/bash
# cmake FALSO, para os testes do libera_fw.sh e do mutante.sh.
#
# Anota cada chamada em $FALSO_DIARIO e imita so o efeito que os scripts
# olham:
#
#   cmake -S <fonte> -B <dir> -DK=V...  cria <dir>/CMakeCache.txt com as -D
#   cmake --build <dir>                 recusa <dir> sem cache, como o de
#                                       verdade; num `build-pico`, deixa o
#                                       .uf2, o .bin e a versao da imagem
#
# O .uf2 carrega o `git describe` do momento do build, como o
# `gera_versao.cmake`, e a versao numerica sai como no
# `versao_imagem.cmake`. E isso que deixa o teste ver se a tag foi criada
# ANTES da reconstrucao.
#
# Ganchos, por ambiente (no nome do diretorio, `-` vira `_`):
#   FALSO_CMAKE_<dir>_<n>    comando que roda durante a n-esima compilacao
#   FALSO_CMAKE_FALHA_<dir>  definida: a compilacao falha
#   FALSO_SEM_BIN            o build-pico nao deixa o .bin
#   FALSO_TAM_BIN            tamanho do .bin, em bytes (padrao 4096)
set -u

if [ "${1:-}" != "--build" ]; then
    echo "cmake $*" >> "$FALSO_DIARIO"
    dir=""
    defs=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -B) dir="$2"; shift ;;
            -D*) defs="$defs ${1#-D}" ;;
        esac
        shift
    done
    [ -n "$dir" ] || exit 1
    mkdir -p "$dir" || exit 1
    : > "$dir/CMakeCache.txt"
    for d in $defs; do
        echo "${d%%=*}:BOOL=${d#*=}" >> "$dir/CMakeCache.txt"
    done
    exit 0
fi

dir="$2"
nome=$(basename "$dir")
var=$(echo "$nome" | tr -- '-' '_')
if [ ! -f "$dir/CMakeCache.txt" ]; then
    echo "cmake $*" >> "$FALSO_DIARIO"
    echo "Error: $dir is not a CMake build directory" >&2
    exit 1
fi
n=$(( $(cat "$dir/.compilacoes" 2>/dev/null || echo 0) + 1 ))
echo "$n" > "$dir/.compilacoes"

gancho="FALSO_CMAKE_${var}_${n}"
if [ -n "${!gancho:-}" ]; then
    eval "${!gancho}"
fi
falha="FALSO_CMAKE_FALHA_${var}"
if [ -n "${!falha:-}" ]; then
    echo "cmake $*" >> "$FALSO_DIARIO"
    exit 1
fi

if [ "$nome" != "build-pico" ]; then
    echo "cmake $* [pre_tag=${CORUJA_BUILD_PRE_TAG:-}]" >> "$FALSO_DIARIO"
    exit 0
fi

descricao=$(git describe --tags --always --dirty='*' 2>/dev/null || echo sem-git)
echo "cmake $* [describe=$descricao] [pre_tag=${CORUJA_BUILD_PRE_TAG:-}]" >> "$FALSO_DIARIO"
versao="0.0"
longa=$(git describe --tags --long --match 'v[0-9]*' 2>/dev/null)
if [[ "$longa" =~ ^v([0-9]+)\.([0-9]+)\.([0-9]+)-([0-9]+)-g ]]; then
    versao="$((BASH_REMATCH[1] * 100 + BASH_REMATCH[2])).$((BASH_REMATCH[3] * 100 + BASH_REMATCH[4]))"
fi
echo "$versao" > "$dir/coruja_gps.uf2.versao"
python3 - "$dir/coruja_gps.uf2" "$descricao" <<'PY' || exit 1
import struct, sys
carga = b"\x00" * 64 + sys.argv[2].encode() + b"\x00" + b"\x00" * 64
blocos = [carga[i:i + 256] for i in range(0, len(carga), 256)]
with open(sys.argv[1], "wb") as f:
    for n, p in enumerate(blocos):
        f.write(struct.pack("<8I", 0x0A324655, 0x9E5D5157, 0x2000,
                            0x10000000 + 256 * n, len(p), n, len(blocos),
                            0xE48BFF59))
        f.write(p.ljust(476, b"\x00") + struct.pack("<I", 0x0AB16F30))
PY
rm -f "$dir/coruja_gps.bin"
if [ -z "${FALSO_SEM_BIN:-}" ]; then
    head -c "${FALSO_TAM_BIN:-4096}" /dev/zero > "$dir/coruja_gps.bin"
fi
exit 0
